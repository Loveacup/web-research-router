# WRR (Web Research Router) 环境变量配置示例
#
# 使用方法：
#   1. 复制此文件: cp .env.example ~/.hermes/.env
#   2. 填写你的 API key 和配置
#   3. wrr-cli.py 会自动加载 ~/.hermes/.env
#
# 或指定自定义路径:
#   export WRR_ENV=/path/to/custom.env
#   wrr-cli.py --env /path/to/custom.env search "query"

# ══════════════════════════════════════════════════════════════════════
# Tier 1: API Key / Token 配置
# ══════════════════════════════════════════════════════════════════════

# Exa AI 搜索引擎
# 申请地址: https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# DeepSeek Search API（/v1/tools/search，自研搜索引擎，与 Exa 同级并行）
# 申请地址: https://platform.deepseek.com/api_keys
# 本机取法（1Password CLI）: op item get "DeepSeek cn API" --fields label=凭据 --reveal
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Jev：有宿主 judge 或以下 key 即默认启用；无 judge 时走确定性默认计划。
# 云端外发限 query、公开候选 title/url/snippet 与公开来源画像；
# 私密、本地、登录态及敏感候选不进入云端 state。
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Brave Search API
# 申请地址: https://brave.com/search/api/
# 主用 key（推荐）:
BRAVE_API_KEY=your_brave_api_key_here
# 或备用 key（向后兼容 Hermes 内置 brave）:
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Tavily Web Search API
# 申请地址: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Token
# 用于 GitHub 仓库搜索和 Skill Discovery
# 申请地址: https://github.com/settings/tokens
# 需要权限: public_repo (或 repo for private repos)
GITHUB_TOKEN=your_github_token_here

# ══════════════════════════════════════════════════════════════════════
# Tier 2: 本地服务配置
# ══════════════════════════════════════════════════════════════════════

# SearXNG 本地实例 URL
# 安装说明: https://docs.searxng.org/
# Docker 快速启动:
#   docker run -d -p 32080:8080 searxng/searxng
SEARXNG_URL=http://127.0.0.1:32080

# 直接抓取（brave extract）代理模式（可选）：系统 DNS 为 fake-IP（如 Surge 增强模式 198.18.0.0/15）时启用。
# 经该 HTTP 代理用 DoH 解析真实地址并做公网检查，再 CONNECT 到该 IP；TLS 仍校验原域名。
# WRR_FETCH_PROXY=http://127.0.0.1:6152
# WRR_FETCH_DOH_URL=https://1.1.1.1/dns-query

# ══════════════════════════════════════════════════════════════════════
# 可选配置
# ══════════════════════════════════════════════════════════════════════

# Community 引擎外部依赖（需手动安装）
# 1. Agent-Reach (opencli): npm install -g opencli
#    仓库: https://github.com/Panniantong/Agent-Reach
# 2. last30days (英文): git clone https://github.com/mvanhorn/last30days-skill ~/code/last30days-skill
# 3. last30days (中文): git clone https://github.com/Jesseovo/last30days-skill-cn ~/code/last30days-skill-cn

# Academic 引擎直接调用 OpenAlex / Semantic Scholar / Crossref / Europe PMC。
# 不需要 paper-search-mcp 服务。OpenAlex key 可选；仅通过 Authorization header 发送。
# OPENALEX_API_KEY=your_openalex_api_key_here

# 显式指定 .env 路径（通常不需要设置，优先级低于 --env 参数）
# WRR_ENV=/path/to/custom.env

# Community 引擎：是否包含 last30days 技能（默认根据触发词启用）
# COMMUNITY_INCLUDE_LAST30DAYS=False

# Academic 引擎：是否包含 arXiv 预印本（默认 False；生医查询另加 Europe PMC）
# ACADEMIC_INCLUDE_ARXIV=False

# ══════════════════════════════════════════════════════════════════════
# 验证配置
# ══════════════════════════════════════════════════════════════════════
#
# 配置完成后运行:
#   wrr-cli.py doctor
#
# 检查指定引擎:
#   wrr-cli.py doctor --engine exa
#   wrr-cli.py doctor --tier 1
#
# JSON 输出:
#   wrr-cli.py doctor --json
